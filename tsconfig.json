{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": [
            "vite/client",
            "fvtt-types"
        ],
        "ignoreDeprecations": "6.0",
        "baseUrl": "./",
        "paths": {
            "~/*": [
                "src/*"
            ],
            "@/*": [
                "src/*"
            ]
        },
        "useDefineForClassFields": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "allowImportingTsExtensions": true
    },
    "include": [
        "src/**/*.d.ts",
        "src/**/*.ts",
        "src/**/*.vue",
        "vite.config.ts"
    ]
}